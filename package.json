{
  "name": "coex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev --",
    "build": "cd apps/web && npm run build --",
    "start": "cd apps/web && npm run start --",
    "lint": "eslint apps packages scripts tests",
    "check:db": "node scripts/check-db.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "reset:password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "check:tasks": "tsx --env-file=.env.local scripts/check-tasks.ts",
    "migrate:spaces": "tsx --env-file=.env.local scripts/migrate-spaces.ts",
    "import:email": "tsx --env-file=.env.local scripts/import-inbound-email.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "check": "npm run test && npm run build",
    "email:worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/src/workers/mail.ts",
    "desk:worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/src/workers/desk-close.ts",
    "channels:worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/src/workers/channels.ts",
    "typecheck": "npm run typecheck -w @coex/web && tsc --noEmit && npm run typecheck -w @coex/shared && npm run typecheck -w @coex/api",
    "api:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/src/server.ts",
    "api:start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/src/server.ts"
  },
  "dependencies": {
    "@coex/api": "*",
    "@coex/shared": "*",
    "@coex/web": "*",
    "@node-rs/argon2": "^2.2.1",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "imapflow": "^2.0.6",
    "jose": "^6.2.12",
    "mailparser": "^3.9.28",
    "mongoose": "^9.10.1",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.10",
    "pdf-lib": "1.17.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0 || >=24.0.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
