{
  "name": "coex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "check:db": "node scripts/check-db.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "reset:password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "check:tasks": "tsx --env-file=.env.local scripts/check-tasks.ts",
    "migrate:spaces": "tsx --env-file=.env.local scripts/migrate-spaces.ts",
    "import:email": "tsx --env-file=.env.local scripts/import-inbound-email.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "check": "npm run test && npm run build",
    "email:worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/email-worker.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "mongoose": "^9.10.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0 || >=24.0.0"
  }
}
