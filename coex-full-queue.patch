+  await Promise.all(
+    orderedIds.map((id, index) =>
+      folders().updateOne(
+        { _id: toObjectId(id), spaceId: toObjectId(spaceId) },
+        { $set: { sortOrder: (index + 1) * 10 } },
+      ),
+    ),
+  );
+}
